{
  "reload_style_on_change": true,
  "layer": "top",
  "position": "top",
  "spacing": 0,
  "height": 26,
  "modules-left": ["custom/launcher", "custom/ws1", "custom/ws2", "custom/ws3", "custom/ws4", "custom/ws5", "custom/ws6", "custom/ws7", "custom/ws8", "custom/ws9", "custom/ws10", "mpris"],
  "modules-center": ["hyprland/window"],
  "modules-right": [
    "group/tray-expander",
    "group/system",
    "battery",
    "backlight",
    "custom/update",
    "group/net",
    "custom/audio",
    "group/actions",
    "clock"
  ],
  "custom/ws1": {
    "format": "{}",
    "exec": "/home/pdev/.config/waybar/scripts/ws-state.sh 1 I",
    "return-type": "json",
    "signal": 8,
    "tooltip": true,
    "on-click": "hyprctl dispatch 'hl.dsp.focus({workspace=1})'",
    "on-click-right": "hyprctl dispatch 'hl.dsp.window.move({workspace=1})'"
  },
  "custom/ws2": {
    "format": "{}",
    "exec": "/home/pdev/.config/waybar/scripts/ws-state.sh 2 II",
    "return-type": "json",
    "signal": 8,
    "tooltip": true,
    "on-click": "hyprctl dispatch 'hl.dsp.focus({workspace=2})'",
    "on-click-right": "hyprctl dispatch 'hl.dsp.window.move({workspace=2})'"
  },
  "custom/ws3": {
    "format": "{}",
    "exec": "/home/pdev/.config/waybar/scripts/ws-state.sh 3 III",
    "return-type": "json",
    "signal": 8,
    "tooltip": true,
    "on-click": "hyprctl dispatch 'hl.dsp.focus({workspace=3})'",
    "on-click-right": "hyprctl dispatch 'hl.dsp.window.move({workspace=3})'"
  },
  "custom/ws4": {
    "format": "{}",
    "exec": "/home/pdev/.config/waybar/scripts/ws-state.sh 4 IV",
    "return-type": "json",
    "signal": 8,
    "tooltip": true,
    "on-click": "hyprctl dispatch 'hl.dsp.focus({workspace=4})'",
    "on-click-right": "hyprctl dispatch 'hl.dsp.window.move({workspace=4})'"
  },
  "custom/ws5": {
    "format": "{}",
    "exec": "/home/pdev/.config/waybar/scripts/ws-state.sh 5 V",
    "return-type": "json",
    "signal": 8,
    "tooltip": true,
    "on-click": "hyprctl dispatch 'hl.dsp.focus({workspace=5})'",
    "on-click-right": "hyprctl dispatch 'hl.dsp.window.move({workspace=5})'"
  },
  "custom/ws6": {
    "format": "{}",
    "exec": "/home/pdev/.config/waybar/scripts/ws-state.sh 6 VI hide",
    "return-type": "json",
    "signal": 8,
    "hide-empty-text": true,
    "tooltip": true,
    "on-click": "hyprctl dispatch 'hl.dsp.focus({workspace=6})'",
    "on-click-right": "hyprctl dispatch 'hl.dsp.window.move({workspace=6})'"
  },
  "custom/ws7": {
    "format": "{}",
    "exec": "/home/pdev/.config/waybar/scripts/ws-state.sh 7 VII hide",
    "return-type": "json",
    "signal": 8,
    "hide-empty-text": true,
    "tooltip": true,
    "on-click": "hyprctl dispatch 'hl.dsp.focus({workspace=7})'",
    "on-click-right": "hyprctl dispatch 'hl.dsp.window.move({workspace=7})'"
  },
  "custom/ws8": {
    "format": "{}",
    "exec": "/home/pdev/.config/waybar/scripts/ws-state.sh 8 VIII hide",
    "return-type": "json",
    "signal": 8,
    "hide-empty-text": true,
    "tooltip": true,
    "on-click": "hyprctl dispatch 'hl.dsp.focus({workspace=8})'",
    "on-click-right": "hyprctl dispatch 'hl.dsp.window.move({workspace=8})'"
  },
  "custom/ws9": {
    "format": "{}",
    "exec": "/home/pdev/.config/waybar/scripts/ws-state.sh 9 IX hide",
    "return-type": "json",
    "signal": 8,
    "hide-empty-text": true,
    "tooltip": true,
    "on-click": "hyprctl dispatch 'hl.dsp.focus({workspace=9})'",
    "on-click-right": "hyprctl dispatch 'hl.dsp.window.move({workspace=9})'"
  },
  "custom/ws10": {
    "format": "{}",
    "exec": "/home/pdev/.config/waybar/scripts/ws-state.sh 10 X hide",
    "return-type": "json",
    "signal": 8,
    "hide-empty-text": true,
    "tooltip": true,
    "on-click": "hyprctl dispatch 'hl.dsp.focus({workspace=10})'",
    "on-click-right": "hyprctl dispatch 'hl.dsp.window.move({workspace=10})'"
  },
  "hyprland/window": {
    "format": "{}",
    "max-length": 50,
    "separate-outputs": true
  },
  "custom/dnd": {
    "format": "{}",
    "exec": "/home/pdev/.config/waybar/scripts/dnd-state.sh",
    "return-type": "json",
    "interval": 5,
    "tooltip": true,
    "on-click": "swaync-client -d"
  },
  "custom/power": {
    "format": "\uf011",
    "tooltip": false,
    "on-click": "/home/pdev/.config/waybar/scripts/power-menu.sh"
  },
  "custom/launcher": {
    "format": "󰣇",
    "on-click": "wofi --show drun",
    "on-click-right": "kitty",
    "tooltip-format": "Launcher\n\nSuper + Space"
  },
  "custom/update": {
    "format": " {text}",
    "exec": "pacman -Qu 2>/dev/null | wc -l",
    "exec-if": "pacman -Qu 2>/dev/null | grep -q .",
    "on-click": "kitty -e sudo pacman -Syu",
    "tooltip-format": "{text} package(s) available",
    "interval": 21600
  },
  "cpu": {
    "interval": 5,
    "format": " 󰍛 {usage}%",
    "on-click": "kitty -e htop",
    "states": { "warning": 70, "critical": 90 }
  },
  "temperature": {
    "interval": 10,
    "thermal-zone": 0,
    "critical-threshold": 85,
    "format": " 󰔏 {temperatureC}°C",
    "tooltip": false
  },
  "backlight": {
    "device": "intel_backlight",
    "format": " {icon} {percent}%",
    "format-icons": ["󰃞", "󰃟", "󰃠"],
    "on-scroll-up": "brightnessctl -e4 -n2 set 5%+",
    "on-scroll-down": "brightnessctl -e4 -n2 set 5%-"
  },
  "disk": {
    "interval": 30,
    "format": " 󱂵 {percentage_free}%",
    "states": { "warning": 80, "critical": 92 }
  },
  "memory": {
    "interval": 30,
    "format": "  {}% ",
    "max-length": 10,
    "on-click": "kitty -e htop",
    "states": { "warning": 75, "critical": 90 }
  },
  "clock": {
    "format": " {:%H:%M}",
    "format-alt": " {:%a %d %b}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
  },
  "network": {
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "format": "{icon}",
    "format-wifi": "{icon}",
    "format-ethernet": "󰀂",
    "format-disconnected": "󰤮",
    "tooltip-format-wifi": "{essid} ({frequency} GHz)\nIP: {ipaddr}/{cidr}\n⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "tooltip-format-ethernet": "IP: {ipaddr}/{cidr}\n⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "tooltip-format-disconnected": "Disconnected",
    "interval": 3,
    "spacing": 1,
    "on-click": "kitty -e nmtui"
  },
  "battery": {
    "format": "{capacity}% {icon}",
    "format-discharging": "{icon}",
    "format-charging": "{icon}",
    "format-plugged": "{icon}\uf1e6",
    "format-icons": {
      "charging": ["󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"],
      "default": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
    },
    "format-full": "󰂅",
    "tooltip-format-discharging": "{power:>1.0f}W↓ {capacity}%",
    "tooltip-format-charging": "{power:>1.0f}W↑ {capacity}%",
    "interval": 5,
    "on-click": "/home/pdev/.config/waybar/scripts/power-menu.sh",
    "states": {
      "warning": 20,
      "critical": 10
    }
  },
  "bluetooth": {
    "format": "",
    "format-disabled": "󰂲",
    "format-connected": "󰂱",
    "format-no-controller": "",
    "tooltip-format": "Devices connected: {num_connections}",
    "on-click": "blueman-manager"
  },
  "custom/audio": {
    "exec": "/home/pdev/.config/waybar/scripts/audio-state.sh",
    "return-type": "json",
    "signal": 11,
    "interval": "once",
    "tooltip": true,
    "on-click": "/home/pdev/.config/hypr/scripts/volume.sh mute",
    "on-click-right": "pavucontrol",
    "on-scroll-up": "/home/pdev/.config/hypr/scripts/volume.sh up --quiet",
    "on-scroll-down": "/home/pdev/.config/hypr/scripts/volume.sh down --quiet"
  },
  "group/tray-expander": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 600,
      "children-class": "tray-group-item"
    },
    "modules": ["custom/expand-icon", "tray"]
  },
  "group/system": {
    "orientation": "inherit",
    "modules": ["memory", "disk", "cpu", "temperature"]
  },
  "group/net": {
    "orientation": "inherit",
    "modules": ["bluetooth", "network"]
  },
  "group/actions": {
    "orientation": "inherit",
    "modules": ["custom/dnd", "custom/power"]
  },
  "custom/expand-icon": {
    "format": "",
    "tooltip": false
  },
  "tray": {
    "icon-size": 12,
    "spacing": 8
  },
  "custom/sep": {
    "format": "|"
  },
  "mpris": {
    "interval": 10,
    "format": "{player_icon} {dynamic}",
    "format-paused": "{status_icon} {artist} {title}",
    "on-click-middle": "playerctl play-pause",
    "on-click": "playerctl previous",
    "on-click-right": "playerctl next",
    "smooth-scrolling-threshold": 1,
    "tooltip": true,
    "tooltip-format": "{status_icon} {dynamic}\nLeft Click: previous\nMid Click: Pause\nRight Click: Next",
    "player-icons": {
      "chromium": "",
      "default": "",
      "firefox": "",
      "kdeconnect": "",
      "mopidy": "",
      "mpv": "󰐹",
      "spotify": "󰎆",
      "vlc": "󰕼"
    },
    "status-icons": {
      "paused": "",
      "playing": "",
      "stopped": ""
    },
    "dynamic-order": ["artist", "title"],
    "ignored-players": ["firefox", "zen"],
    "max-length": 40
  }
}
